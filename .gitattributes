# Auto-detect text files and normalize line endings to LF across all platforms
* text=auto eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.ipynb text eol=lf

# Keep research data and generated results byte-for-byte identical to recorded SHA-256.
data/manifests/*.csv -text -eol
results/** -text -eol

# Preserve the exact E4 producer bytes recorded in run_identity.json.
scripts/run_e4_five_locations_v10_stage7.py.draft -text -eol
# Preserve the new theory table bytes referenced by its figure metadata.
paper/figures/revision_20261015/recall10_ceiling_by_species.csv -text -eol
