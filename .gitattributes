# Auto-detect text files and normalize line endings to LF across all platforms
* text=auto eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.ipynb text eol=lf

# Keep research data and generated results byte-for-byte identical to recorded SHA-256.
data/manifests/*.csv -text -eol
results/** -text -eol

# Preserve the exact E4 producer bytes recorded in run_identity.json.
scripts/run_e4_five_locations_v10_stage7.py.draft -text -eol
# Earlier E4 drafts are historical source snapshots, preserved byte-for-byte too.
scripts/*.py.draft -text -eol
# Preserve the new theory table bytes referenced by its figure metadata.
paper/figures/revision_20261015/recall10_ceiling_by_species.csv -text -eol

# Preserve supporting E4 identity modules exactly as hashed by the frozen run.
scripts/e4_noise_identity_v1.py -text -eol
scripts/e4_query_identity_v1.py -text -eol
scripts/e4_run_identity_v2.py -text -eol

# Keep document and image bytes intact, including PDFs with mostly ASCII streams.
*.pdf binary
*.png binary
*.xlsx binary
*.docx binary
